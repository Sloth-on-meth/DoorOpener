# DoorOpener Environment Configuration
# Copy this file to .env and customize as needed

# Port configuration (matches config.ini [server] port setting)
# Optional: Set custom port (default: 6532)
DOOROPENER_PORT=6532

# Flask configuration
# Flask secret key signing session cookies. REQUIRED for production: anyone who knows it can forge
# an admin session. Min 16 chars; the app refuses to start on placeholder values. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Interface the container port is published on (docker-compose). Keep 127.0.0.1 behind a reverse proxy.
DOOROPENER_BIND=127.0.0.1
# Number of reverse proxies in front of the app whose X-Forwarded-For is trusted (0 = none, direct access)
DOOROPENER_TRUSTED_PROXIES=1
FLASK_DEBUG=false

# When running behind HTTPS (reverse proxy), keep this true so cookies are secure.
# For local HTTP testing only, set to false so the browser will send session cookies.
SESSION_COOKIE_SECURE=true

# Optional: Set timezone (default: UTC)
# Examples: America/New_York, Europe/London, Asia/Tokyo, America/Los_Angeles
TZ=UTC

# Optional: map container runtime user/group to your host user (linuxserver-style)
# This lets the app write to ./logs without host-side chown
PUID=1000
PGID=1000
# Default permissions for created files/dirs
UMASK=002
